{
  "name": "quellabs/canvas-objectquel",
  "description": "ObjectQuel integration for the Canvas PHP framework",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Floris van den Berg",
      "email": "info@quellabs.com"
    }
  ],
  "keywords": [
    "ORM",
    "ObjectQuel",
    "query language",
    "entity manager"
  ],
  "support": {
    "email": "support@quellabs.com",
    "issues": "https://github.com/quellabs/objectquel/issues",
    "forum": "https://github.com/quellabs/objectquel/discussions",
    "wiki": "https://github.com/quellabs/objectquel/wiki",
    "docs": "https://objectquel.quellabs.com/docs",
    "source": "https://github.com/quellabs/objectquel"
  },
  "config": {
    "platform": {
      "php": "8.2"
    }
  },
  "require": {
    "quellabs/annotation-reader": "^1",
    "quellabs/canvas-database": "1.*",
    "quellabs/contracts": "^1.0",
    "quellabs/dependency-injection": "^1.0",
    "quellabs/objectquel": "2.*",
    "quellabs/support": "*"
  },
  "autoload": {
    "psr-4": {
      "Quellabs\\CanvasObjectQuel\\": "src/"
    }
  },
  "extra": {
    "discover": {
      "di": {
        "providers": [
          {
            "class": "Quellabs\\CanvasObjectQuel\\ConfigurationServiceProvider",
            "config": "config/database.php"
          },
          {
            "class": "Quellabs\\CanvasObjectQuel\\ServiceProvider",
            "config": "config/database.php"
          }
        ]
      }
    }
  }
}