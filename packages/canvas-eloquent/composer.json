{
  "name": "quellabs/canvas-eloquent",
  "description": "Eloquent ORM integration for Canvas framework",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "quellabs/annotation-reader": "^1",
    "quellabs/contracts": "^1.0",
    "quellabs/dependency-injection": "^1.0",
    "quellabs/sculpt": "^1.",
    "quellabs/support": "^1.",
    "illuminate/database": "^10.0 || ^11.0"
  },
  "require-dev": {
    "quellabs/canvas": "^1.25",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Quellabs\\CanvasEloquent\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Quellabs\\CanvasEloquent\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "discover": {
      "di": {
        "providers": [
          {
            "class": "Quellabs\\CanvasEloquent\\ServiceProvider",
            "config": "config/eloquent.php"
          },
          {
            "class": "Quellabs\\CanvasEloquent\\ModelBindingServiceProvider",
            "config": "config/eloquent.php"
          }
        ]
      },
      "sculpt": {
        "provider": "Quellabs\\CanvasEloquent\\Sculpt\\EloquentProvider",
        "config": [
          "config/eloquent.php"
        ]
      }
    }
  }
}
