{
  "name": "quellabs/canvas-authorization",
  "description": "",
  "keywords": [
    "canvas-framework"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/quellabs/canvas-authorization",
  "support": {
    "issues": "https://github.com/quellabs/canvas-authorization/issues",
    "source": "https://github.com/quellabs/canvas-authorization"
  },
  "authors": [
    {
      "name": "Quellabs",
      "email": "support@quellabs.com",
      "homepage": "https://www.canvasphp.com"
    }
  ],
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "allow-plugins": {
      "quellabs/discover": true
    }
  },
  "require": {
    "php": ">=8.3",
    "quellabs/canvas": "^1.",
    "quellabs/contracts": "^1.",
    "quellabs/sculpt": "^1.",
    "quellabs/support": "^1."
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "quellabs/objectquel": "^2."
  },
  "suggest": {
    "quellabs/canvas-doctrine": "Scaffolds Doctrine-flavored auth stubs via install:auth",
    "quellabs/canvas-eloquent": "Scaffolds Eloquent-flavored auth stubs via install:auth",
    "quellabs/canvas-objectquel": "Scaffolds ObjectQuel-flavored auth stubs via install:auth (the default when none of these is installed)"
  },
  "autoload": {
    "psr-4": {
      "Quellabs\\CanvasAuthorization\\": "src/"
    },
    "exclude-from-classmap": [
      "/tests/E2E/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Quellabs\\CanvasAuthorization\\Tests\\": "tests/"
    }
  },
  "extra": {
    "discover": {
      "sculpt": {
        "provider": "Quellabs\\CanvasAuthorization\\ServiceProvider"
      }
    }
  }
}
